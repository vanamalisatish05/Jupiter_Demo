{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "node16",
    "allowImportingTsExtensions": true,
    "downlevelIteration": true,
    "strictNullChecks": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@pages": ["test/model/pages/index.ts"],
      "@data": ["test/model/data/index.ts"],
      "@components": ["test/model/components/index.ts"]
    }
  },
  "include": ["playwright.config.ts", "test/**/*.ts"]
}
