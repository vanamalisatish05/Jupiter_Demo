    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Headed",
            "runtimeExecutable": "npm",
            "args": [
                "test",
                "--",
                "--headed",
                "${file}"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "port": 9229,
            "timeout": 60000,
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Headless",
            "runtimeExecutable": "npm",
            "args": [
                "test",
                "--",
                "${file}"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "port": 9229,
            "timeout": 60000,
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Run All Tests",
            "runtimeExecutable": "npm",
            "args": [
                "test",
                "--",
                "-l",
                "trace",
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "port": 9229,
            "timeout": 60000,
        }
    ]
}